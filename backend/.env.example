PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional comma-separated DNS servers for Node DNS queries. Leave unset to use system DNS.
# Configure only DNS servers reachable from this environment.
# MONGODB_DNS_SERVERS=1.0.0.1
# Required for bank-account storage. Generate a dedicated 32-byte key encoded as base64.
# For local development, generate a value with: node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Keep this key stable and separate from JWT_SECRET; losing it makes saved details unreadable.
# BANK_ACCOUNT_ENCRYPTION_KEY=
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Configure a verified payment provider before enabling wallet funding or
# automated withdrawal payouts. Never put these values in frontend variables.
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
