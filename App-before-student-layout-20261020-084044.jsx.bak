function App() {
  return (
    <Routes>
      <Route path="/" element={<Home />} />

      <Route path="/register" element={<Register />} />

      <Route path="/login" element={<Login />} />

      <Route path="/forgot-password" element={<ForgotPassword />} />

      <Route path="/student/dashboard" element={<Dashboard />} />

      <Route path="/student/feed" element={<CampusFeed />} />

      <Route path="/student/messages" element={<Messages />} />

      <Route path="/student/profile" element={<Profile />} />

      <Route path="/student/wallet" element={<Wallet />} />

<Route path="/student/wallet/fund" element={<FundWallet />} />
      
    <Route path="/student/wallet/send" element={<SendMoney />} />

    <Route path="/student/wallet/withdraw" element={<WithdrawFunds />} />

    <Route  path="/student/wallet/bank-account" element={<BankAccounts />} />

    <Route path="/student/transactions"  element={<TransactionHistory />} />

    <Route path="/student/orders" element={<MyOrders />} />

    <Route  path="/student/notifications"  element={<Notifications />} />

<Route  path="/student/services"  element={<Services />} />

    <Route  path="/student/services/:categoryId"  element={<ServiceCategory />} />
    
          <Route
        path="*"
        element={
          <div className="not-found-page">
            <div className="not-found-card">
              <span className="not-found-code">404</span>

              <h1>Page not found</h1>

              <p>
                Sorry, we couldn't find the page you're looking for.
              </p>

              <a href="/" className="button button-primary">
                Back to homepage <ArrowRight size={18} />
              </a>
            </div>
          </div>
        }
      />
    </Routes>
  );
}

export default App;